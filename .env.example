SARVAM_API_KEY=
# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=anand
# ADMIN_PASSCODE=     # required for status changes, alerts and briefs (leave empty = open, local only)
# MOCK=1            # force mock mode even with a key (saves credits while developing UI)
# PORT=3000
